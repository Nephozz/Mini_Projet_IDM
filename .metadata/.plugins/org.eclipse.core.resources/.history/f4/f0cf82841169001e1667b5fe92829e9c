[comment encoding = UTF-8 /]
[module toDot('http://petrinet')]


[template public petrinetToDot(aPetriNet : PetriNet)]
[comment @main/]
[file (aPetriNet.name + '.dot', false, 'UTF-8')]
digraph [aPetriNet.name/] {
[let pls : OrderedSet(Place) = aPetriNet.places]
	[for (pl : Place | pls)]
		[for (arc : Arc | pl.arc)]
			[if (arc.kind = ArcKind::NORMAL)]
				[pl.name/] -> [arc.transition.name/] ['['/]arrowhead=vee label=[arc.weight/][']'/]
			[else]
				[pl.name/] -> [arc.transition.name/] ['['/]arrowhead=dot label=[arc.weight/][']'/]
			[/if]
		[/for]
	[/for]
[/let]
node ['['/]shape=box[']'/]
[let trs : OrderedSet(Transition) = aPetriNet.transitions]
	[for (tr : Transition | trs)]
		[for (arc : Arc | tr.arc)]
			[if (arc.kind = ArcKind::NORMAL)]
				[tr.name/] -> [arc.place.name/] ['['/]arrowhead=vee label=[arc.weight/][']'/]
			[else]
				[tr.name/] -> [arc.place.name/] ['['/]arrowhead=dot label=[arc.weight/][']'/]
			[/if]
		[/for]
	[/for]
[/let]
}
[/file]
[/template]
