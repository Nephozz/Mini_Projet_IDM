import 'PetriNet.ecore'

package petrinet

context PetriNet
inv validName('Invalid name: ' + self.name):
	self.name.matches('[A-Za-z_][A-Za-z0-9_]*')

inv nameIsDefined:
	if self.name.oclIsUndefined() then
		false
	else
		self.name.size() > 1
	endif

context Noeud
inv NomUnique:
    self.name->collect(p | p.oclAsType(Noeud) )
    ->forAll(nd1, nd2 | nd1 = nd2 or nd1.name <> nd2.name)

context Arc
inv SourcePresente:
    (self->select(p | p.placeSource)-> notEmpty()) or (self->select(p | p.transitionSource)-> notEmpty())
	

context Arc
inv DestinationPresente:
    (self->select(p | p.placeDestination)-> notEmpty()) or (self->select(p | p.transitionDestination)-> notEmpty())

context Arc
inv Typediff:
    if (self->select(p | p.placeSource)-> notEmpty()) then
    	(self->select(p | p.transitionDestination)-> notEmpty())
    else
    	(self->select(p | p.placeDestination)-> notEmpty())
    endif

context Place
inv jetonPos: self.jeton >=0
endpackage