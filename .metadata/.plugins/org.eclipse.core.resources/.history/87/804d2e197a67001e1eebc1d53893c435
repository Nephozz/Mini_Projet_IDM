import 'PetriNet.ecore'

package petrinet

context PetriNet
inv validName('Invalid name: ' + self.name):
	self.name.matches('[A-Za-z_][A-Za-z0-9_]*')
--3 le nom d’une activité doit être composé d’au moins deux caractères
inv nameIsDefined:
	if self.name.oclIsUndefined() then
		false
	else
		self.name.size() > 1
	endif

endpackage